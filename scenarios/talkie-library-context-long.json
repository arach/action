{
  "id": "talkie-library-context-long",
  "title": "Talkie Library Context Long",
  "targetApp": {
    "name": "Talkie",
    "bundleId": "to.talkie.app.mac.dev"
  },
  "run": {
    "initialActionDelayMs": 850,
    "actionCadenceMs": 1050
  },
  "stage": {
    "backdrop": "studio",
    "viewport": {
      "id": "main",
      "bounds": {
        "x": 420,
        "y": 96,
        "width": 1320,
        "height": 1180
      },
      "dimming": "surround"
    }
  },
  "scene": {
    "goal": "Capture Talkie screenshot-library browsing into a selected screenshot preview with detail controls",
    "sequence": [
      {
        "action": "click",
        "description": "Return home",
        "target": {
          "text": "Home"
        },
        "cue": {
          "kind": "chapter",
          "text": "Review screenshots",
          "atMs": 0
        }
      },
      {
        "action": "click",
        "description": "Open screenshots",
        "target": {
          "text": "Screenshot"
        }
      },
      {
        "action": "type",
        "description": "Clear screenshot search",
        "input": {
          "text": "",
          "role": "textfield"
        }
      },
      {
        "action": "wait-for-condition",
        "description": "Let screenshots repopulate",
        "input": {
          "durationMs": 700
        }
      },
      {
        "action": "click",
        "description": "Select a previewable screenshot thumbnail",
        "target": {
          "text": "Library screenshot",
          "role": "image"
        }
      },
      {
        "action": "wait-for-condition",
        "description": "Let screenshot preview details settle",
        "input": {
          "durationMs": 900
        }
      },
      {
        "action": "click",
        "description": "Open structured JSON preview",
        "target": {
          "text": "JSON",
          "role": "button"
        }
      },
      {
        "action": "wait-for-condition",
        "description": "Hold on structured preview",
        "input": {
          "durationMs": 700
        }
      },
      {
        "action": "click",
        "description": "Return to text preview",
        "target": {
          "text": "Text",
          "role": "button"
        }
      },
      {
        "action": "wait-for-condition",
        "description": "Hold on selected screenshot detail panel",
        "input": {
          "durationMs": 1200
        }
      }
    ]
  }
}
