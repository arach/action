{
  "id": "talkie-source-review-medium",
  "title": "Talkie Source Review Medium",
  "targetApp": {
    "name": "Talkie",
    "bundleId": "jdi.talkie.core.dev"
  },
  "run": {
    "initialActionDelayMs": 800,
    "actionCadenceMs": 1000
  },
  "stage": {
    "backdrop": "studio",
    "viewport": {
      "id": "main",
      "bounds": {
        "x": 420,
        "y": 96,
        "width": 1320,
        "height": 1180
      },
      "dimming": "surround"
    }
  },
  "scene": {
    "goal": "Capture Talkie switching from workflow selection into a compact review state",
    "sequence": [
      {
        "action": "click",
        "description": "Select Transcribe workflow",
        "target": {
          "text": "Transcribe, 1 step"
        },
        "cue": {
          "kind": "chapter",
          "text": "Compare source flows",
          "atMs": 0
        }
      },
      {
        "action": "click",
        "description": "Select Hey Talkie workflow",
        "target": {
          "text": "Hey Talkie, 3 steps"
        }
      },
      {
        "action": "click",
        "description": "Collapse the first visible step",
        "target": {
          "text": "Go Up"
        }
      },
      {
        "action": "click",
        "description": "Open workflow viewer",
        "target": {
          "text": "VIEW"
        }
      }
    ]
  }
}
