{
  "id": "preframe-source-material-long",
  "title": "Preframe Source Material Long",
  "targetApp": {
    "name": "Google Chrome for Testing",
    "bundleId": "com.google.chrome.for.testing"
  },
  "run": {
    "initialActionDelayMs": 900,
    "actionCadenceMs": 1150,
    "browserUrl": "http://localhost:3100"
  },
  "stage": {
    "backdrop": "studio",
    "viewport": {
      "id": "main",
      "bounds": {
        "x": 260,
        "y": 88,
        "width": 1440,
        "height": 980
      },
      "dimming": "surround"
    }
  },
  "scene": {
    "goal": "Capture a longer Preframe source-material pass across catalog, frames, FX, prompt, and player surfaces",
    "sequence": [
      {
        "action": "click",
        "description": "Open source videos",
        "target": {
          "text": "Videos",
          "role": "button"
        },
        "cue": {
          "kind": "chapter",
          "text": "Shape a source take",
          "atMs": 0
        }
      },
      {
        "action": "click",
        "description": "Queue a source video",
        "target": {
          "text": "Add to queue",
          "role": "button"
        },
        "input": {
          "match": "first"
        }
      },
      {
        "action": "click",
        "description": "Open frames view",
        "target": {
          "text": "Frames",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open the source queue",
        "target": {
          "text": "Queue",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open FX panel",
        "target": {
          "text": "FX Browser",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open prompt panel",
        "target": {
          "text": "Prompts",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open command palette",
        "target": {
          "text": "Command Palette",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open player preview",
        "target": {
          "text": "Open Player",
          "role": "button"
        }
      }
    ]
  }
}
