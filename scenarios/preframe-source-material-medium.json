{
  "id": "preframe-source-material-medium",
  "title": "Preframe Source Material Medium",
  "targetApp": {
    "name": "Google Chrome for Testing",
    "bundleId": "com.google.chrome.for.testing"
  },
  "run": {
    "initialActionDelayMs": 800,
    "actionCadenceMs": 1000,
    "browserUrl": "http://localhost:3100"
  },
  "stage": {
    "backdrop": "studio",
    "viewport": {
      "id": "main",
      "bounds": {
        "x": 260,
        "y": 88,
        "width": 1440,
        "height": 980
      },
      "dimming": "surround"
    }
  },
  "scene": {
    "goal": "Capture Preframe moving from source catalog into queue review and playback",
    "sequence": [
      {
        "action": "click",
        "description": "Open source videos",
        "target": {
          "text": "Videos",
          "role": "button"
        },
        "cue": {
          "kind": "chapter",
          "text": "Queue source material",
          "atMs": 0
        }
      },
      {
        "action": "click",
        "description": "Queue the first source asset",
        "target": {
          "text": "Add to queue",
          "role": "button"
        },
        "input": {
          "match": "first"
        }
      },
      {
        "action": "click",
        "description": "Open queue",
        "target": {
          "text": "Queue",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open player preview",
        "target": {
          "text": "Open Player",
          "role": "button"
        }
      }
    ]
  }
}
