{
  "id": "openscout-control-plane-long",
  "title": "OpenScout Control Plane Long",
  "targetApp": {
    "name": "Google Chrome for Testing",
    "bundleId": "com.google.chrome.for.testing"
  },
  "run": {
    "initialActionDelayMs": 900,
    "actionCadenceMs": 1100,
    "browserUrl": "http://localhost:3200"
  },
  "stage": {
    "backdrop": "studio",
    "viewport": {
      "id": "main",
      "bounds": {
        "x": 260,
        "y": 88,
        "width": 1440,
        "height": 980
      },
      "dimming": "surround"
    }
  },
  "scene": {
    "goal": "Capture a longer OpenScout source pass across the local agent control-plane surfaces",
    "sequence": [
      {
        "action": "click",
        "description": "Open the fleet view",
        "target": {
          "text": "Fleet",
          "role": "button"
        },
        "cue": {
          "kind": "chapter",
          "text": "Tour the agent control plane",
          "atMs": 0
        }
      },
      {
        "action": "click",
        "description": "Open agents",
        "target": {
          "text": "Agents",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open conversations",
        "target": {
          "text": "Conversations",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open sessions",
        "target": {
          "text": "Sessions",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open channels",
        "target": {
          "text": "Channels",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open mesh",
        "target": {
          "text": "Mesh",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open broker",
        "target": {
          "text": "Broker",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open ops",
        "target": {
          "text": "Ops",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open Ranger",
        "target": {
          "text": "Ranger",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open Ranger brief",
        "target": {
          "text": "Brief",
          "role": "button"
        }
      },
      {
        "action": "click",
        "description": "Open command palette",
        "target": {
          "text": "Command Palette",
          "role": "button"
        }
      }
    ]
  }
}
